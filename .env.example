# Database
DATABASE_URL=sqlite+aiosqlite:///data/wine.db

# App
SECRET_KEY=change-me-to-a-random-string
APP_NAME=WINE
# DEBUG disables rate limiting (see backend/middleware.py) — keep false
# except when developing locally over plain HTTP.
DEBUG=false
# SECURE_COOKIES marks the session cookie Secure (HTTPS-only). Set to
# false only for local HTTP dev; must stay true in any deployed environment.
SECURE_COOKIES=true

# External APIs (optional)
# GOOGLE_MAPS_API_KEY=your-google-maps-places-api-key
# WINE_DB_API_KEY=your-grapeminds-or-wine-api-key
# OCR_API_KEY=your-ocr-api-key

# Map (Leaflet with free tiles — no API key needed for OSM)
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png